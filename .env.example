# The Docket — environment variables
#
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
# `.env` (same directory) is used by docker compose for variable interpolation.

# --- Authentication -------------------------------------------------------
# Password for the single-user login screen.
DOCKET_PASSWORD=change-me
# Secret used to sign session JWTs. Required — the app refuses to boot without it.
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me

# --- Database -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@localhost:5432/the_docket

# --- API tokens -----------------------------------------------------------
# Shared secret for the read-only launcher widget endpoint (/api/widget/today).
WIDGET_TOKEN=change-me

# Shared secret for the server-to-server push trigger (/api/push/send).
# The external cron job sends it in the `X-Push-Trigger-Token` header.
# Generate with: openssl rand -hex 32
PUSH_TRIGGER_TOKEN=change-me

# --- Web Push (VAPID) -----------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:you@example.com

# --- Media services (optional) -------------------------------------------
ABS_URL=http://host.docker.internal:13378
ABS_API_KEY=change-me
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=change-me
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=change-me
TMDB_API_KEY=change-me
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=change-me
